{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": ["./app/node_modules"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["lib", "auth", "functions"],
  "exclude": ["**/*.test.ts"]
}
